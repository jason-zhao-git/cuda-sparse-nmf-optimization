\@writefile{toc}{\contentsline {section}{\numberline {6}Visual Summary}{9}{section.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {MU Scaling.} Execution time vs matrix size for all MU optimization levels. The naive L1 implementation grows rapidly with size, while cuBLAS-based methods (L2/L3) scale efficiently. Async multi-GPU (L5) achieves the best performance at large sizes.}}{10}{figure.caption.8}\protected@file@percent }
\newlabel{fig:mu_scaling}{{1}{10}{\textbf {MU Scaling.} Execution time vs matrix size for all MU optimization levels. The naive L1 implementation grows rapidly with size, while cuBLAS-based methods (L2/L3) scale efficiently. Async multi-GPU (L5) achieves the best performance at large sizes}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {MU Speedup.} Speedup relative to the naive L1 baseline. cuBLAS provides up to 12$\times $ speedup on a single GPU, while async multi-GPU (L5 sync=10) achieves 19$\times $ at size 32,000.}}{10}{figure.caption.9}\protected@file@percent }
\newlabel{fig:mu_speedup}{{2}{10}{\textbf {MU Speedup.} Speedup relative to the naive L1 baseline. cuBLAS provides up to 12$\times $ speedup on a single GPU, while async multi-GPU (L5 sync=10) achieves 19$\times $ at size 32,000}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {HALS Scaling.} CPU time grows quadratically ($O(n^2)$) while GPU time remains nearly constant, leading to dramatic speedups at large sizes. At 32,000$\times $32,000, both GPU variants are $\sim $700$\times $ faster than CPU.}}{11}{figure.caption.10}\protected@file@percent }
\newlabel{fig:hals_scaling}{{3}{11}{\textbf {HALS Scaling.} CPU time grows quadratically ($O(n^2)$) while GPU time remains nearly constant, leading to dramatic speedups at large sizes. At 32,000$\times $32,000, both GPU variants are $\sim $700$\times $ faster than CPU}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {HALS Roofline Analysis.} Both GPU implementations achieve balanced utilization: $\sim $27\% of peak compute (10 TFLOPS) and $\sim $38\% of peak memory bandwidth (265 GB/s), indicating efficient use of hardware resources.}}{11}{figure.caption.11}\protected@file@percent }
\newlabel{fig:hals_roofline}{{4}{11}{\textbf {HALS Roofline Analysis.} Both GPU implementations achieve balanced utilization: $\sim $27\% of peak compute (10 TFLOPS) and $\sim $38\% of peak memory bandwidth (265 GB/s), indicating efficient use of hardware resources}{figure.caption.11}{}}
